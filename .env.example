# Copy to .env.local (or .env) and fill in real values. NEVER commit real secrets.

# Groq — powers the /demo chatbot (https://console.groq.com/keys)
GROQ_API_KEY=changeme

# Admin dashboard (/admin) — single admin login
ADMIN_EMAIL=you@arbynex.com
# Use a long, strong password
ADMIN_PASSWORD=changeme
# Secret used to sign the session JWT cookie. Generate: openssl rand -base64 32
SESSION_SECRET=changeme

# n8n automation server (self-hosted on Render)
N8N_BASE_URL=https://your-n8n-host.example.com
# Shared secret checked by every n8n webhook node (Header Auth: x-n8n-token)
N8N_WEBHOOK_TOKEN=changeme

# NOTE: WhatsApp number and contact email are not environment variables —
# they are plain constants in lib/contact.ts (WHATSAPP_NUMBER, EMAIL).
